# Copie este arquivo para .env e preencha os valores antes de subir o projeto.
# cp .env.example .env

# Banco de dados
DB_USER=user
DB_PASSWORD=troque_por_uma_senha_forte
DB_NAME=training_db

# Backend
# SECRET_KEY é obrigatória — a aplicação recusa subir sem ela definida aqui.
SECRET_KEY=troque_por_uma_chave_aleatoria_longa
BASE_URL=https://seu-dominio.com
ALLOWED_ORIGINS=https://seu-dominio.com

# Domínios de e-mail corporativo permitidos (separados por vírgula)
ALLOWED_EMAIL_DOMAINS=geobiogas.tech

# Validade padrão (em meses) aplicada a certificados quando o módulo não define validity_months
CERT_DEFAULT_VALIDITY_MONTHS=12

# Porta exposta (padrão: 8000)
PORT=8000

# Limite de tamanho de upload de vídeo/imagem, em MB (padrão: 2000 = 2GB).
# Se o vídeo passar disso, o upload é rejeitado com erro claro na tela.
MAX_UPLOAD_MB=2000

# URL e credenciais usadas só pelo script backend/run_tests_api.py — mantenha
# API_TEST_BASE_URL separada do BASE_URL de produção para não rodar os testes
# contra produção. TEST_ADMIN_* deve apontar para um admin já existente no
# ambiente onde os testes vão rodar (a senha do admin agora é gerada
# aleatoriamente no seed, não dá mais pra assumir "admin"/"admin").
API_TEST_BASE_URL=http://localhost:8000
TEST_ADMIN_USERNAME=admin
TEST_ADMIN_PASSWORD=troque_pela_senha_real_do_admin_de_teste

# E-mail (opcional) — envio de convites e redefinição de senha por SMTP.
# Se SMTP_HOST ficar em branco, o sistema não tenta enviar nada: continua
# só mostrando o link na tela para o admin copiar e enviar manualmente.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@geobiogas.tech
SMTP_USE_TLS=true

# Lembretes automáticos por e-mail (job diário em background) — dias antes
# do vencimento pra avisar sobre certificado, e dias sem progresso pra
# avisar sobre curso parado. Cada aviso só é mandado uma vez.
CERT_EXPIRY_WARNING_DAYS=30
COURSE_STALLED_REMINDER_DAYS=7
